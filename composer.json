{
    "name": "phil/sitemap",
    "description": "Sitemaps as values: pages with their alternates and images, sections cut into files, and the XML of the sitemap protocol",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "sitemap",
        "seo",
        "hreflang",
        "xml"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "phil/url": "^0.1.3@alpha"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\Sitemap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\Sitemap\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
